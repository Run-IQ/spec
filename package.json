{
  "name": "@run-iq/spec",
  "version": "1.0.0-next.1",
  "description": "Run-IQ rule specification: canonical form, checksum, fingerprint, stored and executable rules, decision proofs, JSON schemas",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./canonical": {
      "import": {
        "types": "./dist/canonical.d.ts",
        "default": "./dist/canonical.js"
      },
      "require": {
        "types": "./dist/canonical.d.cts",
        "default": "./dist/canonical.cjs"
      }
    },
    "./schema/rule-definition.schema.json": "./schema/rule-definition.schema.json",
    "./schema/decision-proof.schema.json": "./schema/decision-proof.schema.json",
    "./schema/referential.schema.json": "./schema/referential.schema.json",
    "./schema/proof-input.schema.json": "./schema/proof-input.schema.json",
    "./schema/fact-disclosure.schema.json": "./schema/fact-disclosure.schema.json",
    "./schema/output-declaration.schema.json": "./schema/output-declaration.schema.json"
  },
  "typesVersions": {
    "*": {
      "canonical": [
        "./dist/canonical.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --project fast",
    "test:heavy": "vitest run --project heavy --no-file-parallelism --maxWorkers=1",
    "bench": "npm run build && node bench/input.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src/ tests/ bench/ --ext .ts,.mjs && prettier --check src/ tests/ schema/ bench/",
    "lint:fix": "eslint src/ tests/ bench/ --ext .ts,.mjs --fix && prettier --write src/ tests/ bench/"
  },
  "keywords": [
    "run-iq",
    "rules-engine",
    "canonical-json",
    "checksum"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Run-IQ/spec.git"
  },
  "homepage": "https://github.com/Run-IQ/spec#readme",
  "bugs": {
    "url": "https://github.com/Run-IQ/spec/issues"
  },
  "author": "Abdou-Raouf ATARMLA",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "ajv": "^8.20.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0"
  }
}
