{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Run-IQ/spec/schema/rule-definition.schema.json",
  "title": "Run-IQ rule definition",
  "description": "A rule definition as accepted by normalizeRuleDefinition from @run-iq/spec. At the top level, null means absent for every optional field and every extension field. Top-level keys other than the named fields are plugin extensions: any JSON value. A rule of the reserved model @run-iq/exception has a non-empty exceptions list and no output. The bounds effectiveFrom and effectiveUntil are both civil dates (YYYY-MM-DD) or both instants (D-13). Three rules are NOT expressible in JSON Schema and are checked only by validateRuleDefinition and normalizeRuleDefinition: effectiveUntil, when set, must be strictly after effectiveFrom (the half-open window [effectiveFrom, effectiveUntil) must not be empty); an instant must stay within the years 0000 to 9999 once its offset is applied; no text (effectiveOn included) may hold a lone UTF-16 surrogate.",
  "type": "object",
  "required": [
    "id",
    "version",
    "model",
    "params",
    "priority",
    "effectiveFrom"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "version": {
      "description": "Positive integer.",
      "type": "integer",
      "minimum": 1
    },
    "model": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "params": {
      "description": "Required; any JSON value, null included (null is data here)."
    },
    "condition": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "dsl",
            "value"
          ],
          "properties": {
            "dsl": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "value": {
              "description": "Any JSON value, null included."
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "priority": {
      "type": "number"
    },
    "effectiveFrom": {
      "description": "Inclusive start: a civil date, or an instant.",
      "$ref": "#/$defs/ruleDate"
    },
    "effectiveUntil": {
      "description": "Exclusive end, of the same form as effectiveFrom; null or absent for no end. Must be after effectiveFrom (checked by validateRuleDefinition only).",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/ruleDate"
        }
      ]
    },
    "timeZone": {
      "description": "The time zone of the window: UTC, a fixed offset +HH:MM/-HH:MM (hour at most 23), or an IANA name Area/Location. +00:00 and -00:00 are normalized to UTC.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/timeZone"
        }
      ]
    },
    "effectiveOn": {
      "description": "The reference date of the window, a JSON pointer: /$dates/<name>, /$item/<path> (needs forEach) or /$segment/from (needs forEach.segments). No '-' segment.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/effectiveOn"
        }
      ]
    },
    "output": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/outputName"
        }
      ]
    },
    "dimensions": {
      "description": "String values; a null value means the dimension is unset.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      ]
    },
    "tags": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "dominanceGroup": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/nonEmptyString"
        }
      ]
    },
    "exceptions": {
      "description": "The exceptions the rule carries, in order. null and [] mean absent.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ruleException"
          }
        }
      ]
    },
    "sourceRef": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/nonEmptyString"
        }
      ]
    },
    "checksum": {
      "description": "Ignored: never part of the definition."
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "description": "The reserved model @run-iq/exception only carries exceptions: at least one, and no output.",
      "if": {
        "required": [
          "model"
        ],
        "properties": {
          "model": {
            "const": "@run-iq/exception"
          }
        }
      },
      "then": {
        "required": [
          "exceptions"
        ],
        "properties": {
          "exceptions": {
            "type": "array",
            "minItems": 1
          },
          "output": {
            "type": "null"
          }
        }
      }
    },
    {
      "description": "Both bounds have the same form: a civil effectiveFrom goes with a civil effectiveUntil (D-13).",
      "if": {
        "required": [
          "effectiveFrom"
        ],
        "properties": {
          "effectiveFrom": {
            "$ref": "#/$defs/civilDate"
          }
        }
      },
      "then": {
        "properties": {
          "effectiveUntil": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/civilDate"
              }
            ]
          }
        }
      }
    },
    {
      "description": "Both bounds have the same form: an instant effectiveFrom goes with an instant effectiveUntil (D-13).",
      "if": {
        "required": [
          "effectiveFrom"
        ],
        "properties": {
          "effectiveFrom": {
            "$ref": "#/$defs/instant"
          }
        }
      },
      "then": {
        "properties": {
          "effectiveUntil": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/instant"
              }
            ]
          }
        }
      }
    },
    {
      "description": "effectiveOn on /$item/ needs a forEach.",
      "if": {
        "required": [
          "effectiveOn"
        ],
        "properties": {
          "effectiveOn": {
            "type": "string",
            "pattern": "^/\\$item/"
          }
        }
      },
      "then": {
        "required": [
          "forEach"
        ],
        "properties": {
          "forEach": {
            "not": {
              "type": "null"
            }
          }
        }
      }
    },
    {
      "description": "effectiveOn on /$segment/ needs forEach.segments.",
      "if": {
        "required": [
          "effectiveOn"
        ],
        "properties": {
          "effectiveOn": {
            "type": "string",
            "pattern": "^/\\$segment/"
          }
        }
      },
      "then": {
        "required": [
          "forEach"
        ],
        "properties": {
          "forEach": {
            "type": "object",
            "required": [
              "segments"
            ],
            "properties": {
              "segments": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "outputName": {
      "description": "An output name: a non-empty string not starting with $ (names starting with $ are reserved).",
      "type": "string",
      "pattern": "^[^$]"
    },
    "ruleDate": {
      "description": "A civil date or an instant.",
      "anyOf": [
        {
          "$ref": "#/$defs/civilDate"
        },
        {
          "$ref": "#/$defs/instant"
        }
      ]
    },
    "civilDate": {
      "description": "A civil date YYYY-MM-DD that exists (proleptic Gregorian, years 0000 to 9999). It stays civil after normalization.",
      "type": "string",
      "pattern": "^(?:\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|02-(?:0[1-9]|1\\d|2[0-8]))|(?:\\d{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)$"
    },
    "instant": {
      "description": "An instant YYYY-MM-DDTHH:MM:SS with 0 to 3 decimals and Z or an offset +HH:MM/-HH:MM (uppercase T and Z, second 00 to 59, offset hour at most 23). A date-time without a time zone is refused. Normalized to YYYY-MM-DDTHH:MM:SS.sssZ.",
      "type": "string",
      "pattern": "^(?:\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|02-(?:0[1-9]|1\\d|2[0-8]))|(?:\\d{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,3})?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
    },
    "timeZone": {
      "description": "UTC, +HH:MM/-HH:MM (hour at most 23, minute at most 59), or an IANA name: segments [A-Za-z][A-Za-z0-9_+-]* separated by /, at least two, the first starting with an uppercase letter.",
      "type": "string",
      "pattern": "^(?:UTC|[+-](?:[01]\\d|2[0-3]):[0-5]\\d|[A-Z][A-Za-z0-9_+-]*(?:/[A-Za-z][A-Za-z0-9_+-]*)+)$"
    },
    "effectiveOn": {
      "description": "A JSON pointer (RFC 6901) to a reference date: /$dates/<name> (one non-empty name), /$item/<path> or /$segment/from. A '-' segment is refused.",
      "type": "string",
      "pattern": "^/(?:\\$dates/(?!-$)(?:[^/~]|~[01])+|\\$item(?:/(?!-(?:/|$))(?:[^/~]|~[01])*)+|\\$segment/from)$"
    },
    "ruleException": {
      "description": "One exception: inhibit the targeted rules, substitute params into them (deep merge), or short-circuit one output to a value.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "targets"
          ],
          "properties": {
            "kind": {
              "const": "inhibit"
            },
            "targets": {
              "$ref": "#/$defs/ruleSelector"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "targets",
            "params"
          ],
          "properties": {
            "kind": {
              "const": "substitute"
            },
            "targets": {
              "$ref": "#/$defs/ruleSelector"
            },
            "params": {
              "description": "Parameters deep-merged into the targeted rules' params.",
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "output",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "shortCircuit"
            },
            "output": {
              "$ref": "#/$defs/outputName"
            },
            "value": {
              "description": "Any JSON value, null included."
            },
            "reason": {
              "$ref": "#/$defs/nonEmptyString"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ruleSelector": {
      "description": "Fields combine by AND, the values of one field by OR; dimensions require every key to be equal. An empty field puts no constraint; at least one field must be non-empty.",
      "type": "object",
      "properties": {
        "ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outputName"
          }
        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "ids"
          ],
          "properties": {
            "ids": {
              "type": "array",
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "tags"
          ],
          "properties": {
            "tags": {
              "type": "array",
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "dimensions"
          ],
          "properties": {
            "dimensions": {
              "type": "object",
              "minProperties": 1
            }
          }
        },
        {
          "required": [
            "outputs"
          ],
          "properties": {
            "outputs": {
              "type": "array",
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "models"
          ],
          "properties": {
            "models": {
              "type": "array",
              "minItems": 1
            }
          }
        }
      ]
    }
  }
}
