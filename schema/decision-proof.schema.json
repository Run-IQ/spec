{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Run-IQ/spec/schema/decision-proof.schema.json",
  "title": "Run-IQ decision proof",
  "description": "A sealed decision proof (format run-iq.proof/1) as checked by validateProof from @run-iq/spec. The format is closed: every object refuses unknown keys. The proof holds the digest of the input, never the input. digest is the sha256 of the canonical proof without digest and signature; signature, when present, is the ed25519 signature of the 64 ASCII characters of digest. This schema checks the shape only; verifyProof checks the digest and the signature. The internal consistency is checked only by verifyProof, sealProof and signProof, never by this schema nor validateProof: every rule cited in applied, skipped, exceptions, output contributors and exception affected is listed in rules; every name in strata is a key of outputs (no unknown stratum output) and appears once (no repeated stratum output); every key of outputs is in a stratum; every stratum index of applied, skipped and exceptions is an index of strata; every applied rule's output is in its stratum; no output key, stratum name or applied output starts with $ (reserved names, ruling R36); and every decimal output holds a canonical decimal string as its value, and as the contribution and unrounded value of every applied rule feeding it. Three rules are NOT expressible in JSON Schema and are checked only by validateProof: no two entries of rules have the same id and version; every output value, contribution and unrounded value nests at most 1000 levels of non-empty arrays or objects (MAX_JSON_DEPTH; {\"a\": 1} is 1 level); a proof holds at most 10000000 values in all (MAX_JSON_VALUES, list lengths counted before any element is read).",
  "type": "object",
  "required": [
    "format",
    "requestId",
    "evaluatedAt",
    "sealedAt",
    "inputDigest",
    "rules",
    "versions",
    "strata",
    "outputs",
    "applied",
    "skipped",
    "exceptions",
    "digest"
  ],
  "properties": {
    "format": {
      "const": "run-iq.proof/1"
    },
    "requestId": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "evaluatedAt": {
      "description": "The effective date of the evaluation, or null.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/isoDate"
        }
      ]
    },
    "sealedAt": {
      "$ref": "#/$defs/isoDate"
    },
    "inputDigest": {
      "$ref": "#/$defs/sha256Hex"
    },
    "rules": {
      "description": "The rules the evaluation received.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ruleRef"
      }
    },
    "ruleSet": {
      "description": "The published pack the rules come from.",
      "type": "object",
      "required": ["kind", "id", "version", "digest"],
      "properties": {
        "kind": {
          "const": "pack"
        },
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "digest": {
          "$ref": "#/$defs/sha256Hex"
        }
      },
      "additionalProperties": false
    },
    "versions": {
      "type": "object",
      "required": ["engine", "plugins", "dsls"],
      "properties": {
        "engine": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "plugins": {
          "$ref": "#/$defs/versionMap"
        },
        "dsls": {
          "$ref": "#/$defs/versionMap"
        }
      },
      "additionalProperties": false
    },
    "strata": {
      "description": "The output names of each evaluation stratum, in evaluation order. A stratum may be empty.",
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "outputs": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/output"
      }
    },
    "applied": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skip"
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exception"
      }
    },
    "digest": {
      "$ref": "#/$defs/sha256Hex"
    },
    "signature": {
      "type": "object",
      "required": ["alg", "keyId", "value"],
      "properties": {
        "alg": {
          "const": "ed25519"
        },
        "keyId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "value": {
          "description": "64 bytes in base64url without padding.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "stratumIndex": {
      "description": "The index of a stratum in strata: a safe integer, 0 or more.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sha256Hex": {
      "description": "Lowercase sha256 hex.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "isoDate": {
      "description": "YYYY-MM-DD or an ISO 8601 date-time with Z or a +HH:MM/-HH:MM offset, as for rule dates.",
      "type": "string",
      "pattern": "^(?:\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|02-(?:0[1-9]|1\\d|2[0-8]))|(?:\\d{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)(?:T(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d{1,9})?)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d))?$"
    },
    "versionMap": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "ruleRef": {
      "type": "object",
      "required": ["id", "version", "checksum"],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "version": {
          "$ref": "#/$defs/positiveInteger"
        },
        "checksum": {
          "$ref": "#/$defs/sha256Hex"
        },
        "sourceRef": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "output": {
      "description": "An output. Its combine applies to its type, as in an output declaration; rounding, when present, applies to a number or decimal output that is not a count, and is written in its normal form.",
      "type": "object",
      "required": ["type", "combine", "value", "contributors"],
      "properties": {
        "type": {
          "enum": [
            "number",
            "boolean",
            "string",
            "enum",
            "list",
            "object",
            "decimal",
            "date",
            "dateTime"
          ]
        },
        "combine": {
          "enum": ["sum", "max", "min", "highestPriority", "union", "all", "any", "count"]
        },
        "value": {
          "description": "Any JSON value, null included."
        },
        "contributors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "rounding": {
          "$ref": "#/$defs/rounding"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "enum": ["boolean", "string", "enum", "list", "object", "date", "dateTime"]
              }
            }
          },
          "then": {
            "properties": {
              "rounding": false
            }
          }
        },
        {
          "description": "sum combines number, decimal.",
          "if": {
            "type": "object",
            "required": ["combine"],
            "properties": {
              "combine": {
                "enum": ["sum"]
              }
            }
          },
          "then": {
            "properties": {
              "type": {
                "enum": ["number", "decimal"]
              }
            }
          }
        },
        {
          "description": "max combines number, decimal, enum, date, dateTime.",
          "if": {
            "type": "object",
            "required": ["combine"],
            "properties": {
              "combine": {
                "enum": ["max"]
              }
            }
          },
          "then": {
            "properties": {
              "type": {
                "enum": ["number", "decimal", "enum", "date", "dateTime"]
              }
            }
          }
        },
        {
          "description": "min combines number, decimal, enum, date, dateTime.",
          "if": {
            "type": "object",
            "required": ["combine"],
            "properties": {
              "combine": {
                "enum": ["min"]
              }
            }
          },
          "then": {
            "properties": {
              "type": {
                "enum": ["number", "decimal", "enum", "date", "dateTime"]
              }
            }
          }
        },
        {
          "description": "union combines list.",
          "if": {
            "type": "object",
            "required": ["combine"],
            "properties": {
              "combine": {
                "enum": ["union"]
              }
            }
          },
          "then": {
            "properties": {
              "type": {
                "enum": ["list"]
              }
            }
          }
        },
        {
          "description": "all combines boolean.",
          "if": {
            "type": "object",
            "required": ["combine"],
            "properties": {
              "combine": {
                "enum": ["all"]
              }
            }
          },
          "then": {
            "properties": {
              "type": {
                "enum": ["boolean"]
              }
            }
          }
        },
        {
          "description": "any combines boolean.",
          "if": {
            "type": "object",
            "required": ["combine"],
            "properties": {
              "combine": {
                "enum": ["any"]
              }
            }
          },
          "then": {
            "properties": {
              "type": {
                "enum": ["boolean"]
              }
            }
          }
        },
        {
          "description": "count combines number.",
          "if": {
            "type": "object",
            "required": ["combine"],
            "properties": {
              "combine": {
                "enum": ["count"]
              }
            }
          },
          "then": {
            "properties": {
              "type": {
                "enum": ["number"]
              }
            }
          }
        },
        {
          "description": "No rounding on a count: its value is an integer.",
          "if": {
            "type": "object",
            "required": ["combine"],
            "properties": {
              "combine": {
                "enum": ["count"]
              }
            }
          },
          "then": {
            "properties": {
              "rounding": false
            }
          }
        },
        {
          "description": "A number output rounds to a scale: an increment applies to a decimal output only.",
          "if": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "const": "number"
              }
            }
          },
          "then": {
            "properties": {
              "rounding": {
                "properties": {
                  "increment": false
                },
                "type": "object"
              }
            }
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "required": ["ruleId", "version", "model", "output", "contribution", "stratum"],
      "properties": {
        "ruleId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "version": {
          "$ref": "#/$defs/positiveInteger"
        },
        "model": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "output": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "contribution": {
          "description": "Any JSON value, null included."
        },
        "stratum": {
          "$ref": "#/$defs/stratumIndex"
        },
        "unrounded": {
          "description": "The contribution before rounding, when it was rounded: any JSON value, null included."
        },
        "sourceRef": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "skip": {
      "type": "object",
      "required": ["ruleId", "version", "reason", "stratum"],
      "properties": {
        "ruleId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "version": {
          "$ref": "#/$defs/positiveInteger"
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "detail": {
          "type": "string"
        },
        "stratum": {
          "$ref": "#/$defs/stratumIndex"
        }
      },
      "additionalProperties": false
    },
    "exception": {
      "type": "object",
      "required": ["ruleId", "version", "kind", "affected", "stratum"],
      "properties": {
        "ruleId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "version": {
          "$ref": "#/$defs/positiveInteger"
        },
        "kind": {
          "enum": ["inhibit", "substitute", "shortCircuit"]
        },
        "affected": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "stratum": {
          "$ref": "#/$defs/stratumIndex"
        }
      },
      "additionalProperties": false
    },
    "rounding": {
      "description": "A declared rounding in its normal form (normalizeOutputDeclaration): mode, with exactly one of scale (decimal places, 0 to 20) and increment (a canonical decimal string greater than 0 with at most 20 digits before its point and 20 after it that is not a power of ten from 1 to 10^-20, which is written as its scale: 0.05, 10); at is contribution or absent (output, the default, is never written).",
      "type": "object",
      "required": ["mode"],
      "oneOf": [
        {
          "required": ["scale"],
          "properties": {
            "scale": {}
          }
        },
        {
          "required": ["increment"],
          "properties": {
            "increment": {}
          }
        }
      ],
      "properties": {
        "scale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "increment": {
          "type": "string",
          "pattern": "^(?!1$)(?!0\\.0*1$)(0\\.[0-9]{0,19}[1-9]|[1-9][0-9]{0,19}(\\.[0-9]{0,19}[1-9])?)$"
        },
        "mode": {
          "enum": ["halfUp", "halfDown", "halfEven", "up", "down", "ceiling", "floor"]
        },
        "at": {
          "enum": ["contribution"]
        }
      },
      "additionalProperties": false
    }
  }
}
