{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Run-IQ/spec/schema/decision-proof.schema.json",
  "title": "Run-IQ decision proof",
  "description": "A sealed decision proof (format run-iq.proof/1) as checked by validateProof from @run-iq/spec. The format is closed: every object refuses unknown keys. The proof holds the digest of the input, never the input. digest is the sha256 of the canonical proof without digest and signature; signature, when present, is the ed25519 signature of the 64 ASCII characters of digest. This schema checks the shape only; verifyProof checks the digest and the signature. One rule is NOT expressible in JSON Schema and is checked only by validateProof: no two entries of rules have the same id and version.",
  "type": "object",
  "required": [
    "format",
    "requestId",
    "evaluatedAt",
    "sealedAt",
    "inputDigest",
    "rules",
    "versions",
    "outputs",
    "applied",
    "skipped",
    "exceptions",
    "digest"
  ],
  "properties": {
    "format": {
      "const": "run-iq.proof/1"
    },
    "requestId": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "evaluatedAt": {
      "description": "The effective date of the evaluation, or null.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/isoDate"
        }
      ]
    },
    "sealedAt": {
      "$ref": "#/$defs/isoDate"
    },
    "inputDigest": {
      "$ref": "#/$defs/sha256Hex"
    },
    "rules": {
      "description": "The rules the evaluation received.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ruleRef"
      }
    },
    "ruleSet": {
      "description": "The published pack the rules come from.",
      "type": "object",
      "required": [
        "kind",
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "kind": {
          "const": "pack"
        },
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "digest": {
          "$ref": "#/$defs/sha256Hex"
        }
      },
      "additionalProperties": false
    },
    "versions": {
      "type": "object",
      "required": [
        "engine",
        "plugins",
        "dsls"
      ],
      "properties": {
        "engine": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "plugins": {
          "$ref": "#/$defs/versionMap"
        },
        "dsls": {
          "$ref": "#/$defs/versionMap"
        }
      },
      "additionalProperties": false
    },
    "outputs": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/output"
      }
    },
    "applied": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skip"
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exception"
      }
    },
    "digest": {
      "$ref": "#/$defs/sha256Hex"
    },
    "signature": {
      "type": "object",
      "required": [
        "alg",
        "keyId",
        "value"
      ],
      "properties": {
        "alg": {
          "const": "ed25519"
        },
        "keyId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "value": {
          "description": "64 bytes in base64url without padding.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "sha256Hex": {
      "description": "Lowercase sha256 hex.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "isoDate": {
      "description": "YYYY-MM-DD or an ISO 8601 date-time with Z or a +HH:MM/-HH:MM offset, as for rule dates.",
      "type": "string",
      "pattern": "^(?:\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|02-(?:0[1-9]|1\\d|2[0-8]))|(?:\\d{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)(?:T(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d{1,9})?)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d))?$"
    },
    "versionMap": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "ruleRef": {
      "type": "object",
      "required": [
        "id",
        "version",
        "checksum"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "version": {
          "$ref": "#/$defs/positiveInteger"
        },
        "checksum": {
          "$ref": "#/$defs/sha256Hex"
        },
        "sourceRef": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": [
        "type",
        "combine",
        "value",
        "contributors"
      ],
      "properties": {
        "type": {
          "enum": [
            "number",
            "boolean",
            "string",
            "enum",
            "list",
            "object"
          ]
        },
        "combine": {
          "enum": [
            "sum",
            "max",
            "min",
            "highestPriority",
            "union",
            "all",
            "any"
          ]
        },
        "value": {
          "description": "Any JSON value, null included."
        },
        "contributors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": [
        "ruleId",
        "version",
        "model",
        "output",
        "contribution"
      ],
      "properties": {
        "ruleId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "version": {
          "$ref": "#/$defs/positiveInteger"
        },
        "model": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "output": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "contribution": {
          "description": "Any JSON value, null included."
        },
        "sourceRef": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "skip": {
      "type": "object",
      "required": [
        "ruleId",
        "version",
        "reason"
      ],
      "properties": {
        "ruleId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "version": {
          "$ref": "#/$defs/positiveInteger"
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "detail": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "exception": {
      "type": "object",
      "required": [
        "ruleId",
        "version",
        "kind",
        "affected"
      ],
      "properties": {
        "ruleId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "version": {
          "$ref": "#/$defs/positiveInteger"
        },
        "kind": {
          "enum": [
            "inhibit",
            "substitute",
            "shortCircuit"
          ]
        },
        "affected": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
